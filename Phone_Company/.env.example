# Copy this file to .env and fill in your Stripe keys for local development
# Do NOT commit your real keys to version control.

# Server-side secret key (starts with sk_test_...)
STRIPE_SECRET_KEY=sk_test_replace_with_your_key

# Stripe CLI webhook signing secret (starts with whsec_...)
STRIPE_WEBHOOK_SECRET=

# Client-side publishable key (starts with pk_test_...)
STRIPE_PUBLISHABLE_KEY=
